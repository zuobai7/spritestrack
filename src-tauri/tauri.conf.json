{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SpriteStrack",
  "version": "../package.json",
  "identifier": "io.github.zuobai7.spritestrack",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SpriteStrack",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "GraphicsAndDesign",
    "shortDescription": "Voxel editor for sprite-stacked and 3D game art",
    "longDescription": "Model voxels, animate them with frames or part-based skeletal animation, and export sprite sheets, GIFs, normal and depth maps, or GLB/OBJ/VOX models.",
    "copyright": "Copyright (c) SpriteStrack contributors. MIT License.",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "10.15"
    }
  }
}
